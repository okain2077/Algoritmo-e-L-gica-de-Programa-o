programa {
  funcao inicio() {
    
    real a, b, c, soma, sub, mult, div, dobro, triplo, suc, ant, alturat, baset, areat, lado1, lado2, perimetro
    
    escreva("Digite um numero: ")
    leia(a)
    escreva("Digite um segundo numero: ")
    leia(b)

    soma = a + b
    sub = a - b
    mult = a * b
    div = a / b
    

    escreva("A soma é: ", soma, "\n") 
    escreva("A subtração é: ", sub, "\n")
    escreva("A multiplicação é: ", mult, "\n")
    escreva("A divisão é ", div, "\n")
    
    escreva("Digite um numero: ")
    leia(c)

    dobro = c * 2
    triplo = c * 3
    ant = c - 1
    suc = c + 1

    escreva("O dobro é: ", dobro, "\n")
    escreva("o triplo é: ",triplo, "\n")
    escreva("O antecessor é: ", ant, "\n")
    escreva("O sucesor é : ", suc, "\n")

    escreva("Qual a altura do triângulo: ")
    leia(alturat)
    escreva("Qual a base do triângulo: ")
    leia(baset)

    areat = (baset * alturat) / 2

    escreva("A área do triângulo é: ", areat, "\n")

    escreva("Digite o lado1 do retângulo: ")
    leia(lado1)
    escreva("Digite o lado2 do retângulo: ")
    leia(lado2)

    perimetro = (lado1 * 2) + (lado2 * 2)

    escreva("O perímetro do retângulo é: ", perimetro)



    
  }
}
